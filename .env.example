# ==============================================================================
# PlacifyAI — Environment Variables
# ==============================================================================

# 1. Supabase Configuration (Get from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Free SMTP / Email OTP Service (Optional - for custom high-volume dispatch)
# Options:
# - Gmail SMTP (Host: smtp.gmail.com, Port: 465 or 587, User: your-email@gmail.com, Pass: App Password)
# - Brevo (Host: smtp-relay.brevo.com, Port: 587, 300 free emails/day)
# - Resend (Host: smtp.resend.com, Port: 465, 3,000 free emails/mo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PlacifyAI Security" <no-reply@placify.ai>

# 3. Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
